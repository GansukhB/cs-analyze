# Local development. `npm run setup` copies this to .env if it doesn't exist.
DATABASE_URL=mysql+pymysql://cs:cs@localhost:13306/cs_analyze
REDIS_BROKER_URL=redis://localhost:16379/0
REDIS_RESULT_URL=redis://localhost:16379/1
REDIS_CACHE_URL=redis://localhost:16379/2
JWT_SECRET=dev-only-insecure-secret-change-me-32b
CORS_ORIGINS=["http://localhost:5173"]

# HLTV pipeline (defaults shown). Archives are 100-500 MB each.
# HLTV_DATA_DIR=../../data
# HLTV_HEADLESS=true            # false opens a visible Chromium, to clear Cloudflare by hand
# HLTV_REQUEST_DELAY_MS=1500

# Assistant (optional). Without CLAUDE_API_KEY the chat says it isn't configured;
# without the ElevenLabs pair it answers in text only and the mic is hidden.
CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_EFFORT=medium
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_v3
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_STT_LANGUAGE=mon
