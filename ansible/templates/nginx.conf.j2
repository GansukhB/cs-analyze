# Rendered by ansible (tasks/nginx.yml); overwritten on every deploy.
# {{ public_domain }}: the built public app. {{ api_domain }}: the API on 127.0.0.1:{{ api_port }}.
# Both are behind Cloudflare's proxy. Until certbot.yml has issued the
# certificate this serves plain HTTP only; re-rendering afterwards adds HTTPS.

map $http_upgrade $cs2_connection_upgrade {
    default upgrade;
    ''      close;
}

{% macro head(domain) %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }};

    # Let's Encrypt renewals (webroot, see certbot.yml).
    location /.well-known/acme-challenge/ {
        root {{ certbot_webroot }};
    }
{% if tls_ready %}
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ tls_cert_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ tls_cert_name }}/privkey.pem;
    ssl_session_cache shared:cs2_SSL:10m;
    ssl_session_timeout 1440m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305";
{% endif %}
{% endmacro %}

{{ head(public_domain) }}
    root {{ app_path }}/apps/public/dist;

    # Vite fingerprints everything under assets/, so it never changes in place.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Client-side routes (/teams/12, /gameplan/...) all load index.html, which
    # must be revalidated so a deploy is picked up.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}

{{ head(api_domain) }}
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:{{ api_port }};
        proxy_http_version 1.1;
        # WS /ws/jobs/{id} shares the location with plain HTTP.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $cs2_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
