# Rendered by ansible (tasks/nginx.yml); overwritten on every deploy.
# {{ public_domain }}: the built public app. {{ api_domain }}: the API on 127.0.0.1:{{ api_port }}.
# Both are behind Cloudflare's proxy. Until certbot.yml has issued the
# certificate this serves plain HTTP only; re-rendering afterwards adds HTTPS.

map $http_upgrade $cs2_connection_upgrade {
    default upgrade;
    ''      close;
}

# Behind Cloudflare the peer is one of its edges; it passes the visitor's address
# in CF-Connecting-IP. Limits per visitor: sign-in attempts (each costs an argon2
# hash) and Assistant turns (each costs Claude and ElevenLabs credit). The API
# also counts failed sign-ins per Username (app/routers/auth.py).
map $http_cf_connecting_ip $cs2_client {
    default $http_cf_connecting_ip;
    ''      $remote_addr;
}
limit_req_zone $cs2_client zone=cs2_auth:10m rate=10r/m;
limit_req_zone $cs2_client zone=cs2_assistant:10m rate=20r/m;
limit_req_status 429;

{% macro head(domain) %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }};

    # Let's Encrypt renewals (webroot, see certbot.yml).
    location /.well-known/acme-challenge/ {
        root {{ certbot_webroot }};
    }
{% if tls_ready %}
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ tls_cert_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ tls_cert_name }}/privkey.pem;
    ssl_session_cache shared:cs2_SSL:10m;
    ssl_session_timeout 1440m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305";
{% endif %}
{% endmacro %}

{% macro page_headers() %}
        # nginx drops server-level add_header in a location that has its own, so
        # each location of the app repeats these. Styles stay 'unsafe-inline': React
        # and the server-drawn SVG set style attributes. The Assistant's speech plays
        # from data:/blob: URLs; the API is the only other origin (docs/adr/0001).
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://{{ api_domain }} wss://{{ api_domain }}; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
{% endmacro %}
{{ head(public_domain) }}
    root {{ app_path }}/apps/public/dist;

    # Vite fingerprints everything under assets/, so it never changes in place.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
{{ page_headers() }}
        try_files $uri =404;
    }

    # Client-side routes (/teams/12, /gameplan/...) all load index.html, which
    # must be revalidated so a deploy is picked up.
    location / {
        add_header Cache-Control "no-cache";
{{ page_headers() }}
        try_files $uri /index.html;
    }
}

{{ head(api_domain) }}
    # A spoken question for the Assistant is uploaded whole (the API caps it at 10 MB).
    client_max_body_size 10m;

{% macro proxy() %}
        proxy_pass http://127.0.0.1:{{ api_port }};
        proxy_http_version 1.1;
        # WS /ws/jobs/{id} shares the location with plain HTTP.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $cs2_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $cs2_client;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
{% endmacro %}
    location = /auth/token {
        limit_req zone=cs2_auth burst=5 nodelay;
{{ proxy() }}
    }

    location /assistant/ {
        limit_req zone=cs2_assistant burst=10 nodelay;
{{ proxy() }}
    }

    # An uploaded Demo arrives in parts of 15 MiB (app/models/upload.py PART_BYTES),
    # well under Cloudflare's 100 MB per request.
    location /uploads/ {
        client_max_body_size 16m;
{{ proxy() }}
    }

    location / {
{{ proxy() }}
    }
}
