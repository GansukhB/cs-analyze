# Rendered by ansible/deploy.yml; overwritten on every deploy, do not edit here.
# The API, the worker and any CLI run from this directory (`uv run python -m
# app.cli create-user`) all read it.
{% if mysql_host in ['localhost', '127.0.0.1', ''] %}
DATABASE_URL=mysql+pymysql://{{ mysql_user | urlencode }}:{{ mysql_password | urlencode }}@localhost/{{ mysql_database }}?unix_socket={{ mysql_socket }}
{% else %}
DATABASE_URL=mysql+pymysql://{{ mysql_user | urlencode }}:{{ mysql_password | urlencode }}@{{ mysql_host }}:{{ mysql_port }}/{{ mysql_database }}
{% endif %}
REDIS_BROKER_URL={{ redis_url }}/{{ redis_dbs.broker }}
REDIS_RESULT_URL={{ redis_url }}/{{ redis_dbs.result }}
REDIS_CACHE_URL={{ redis_url }}/{{ redis_dbs.cache }}
JWT_SECRET={{ jwt_secret }}
CORS_ORIGINS=["https://{{ public_domain }}"]
# Swagger off: it maps every endpoint for anyone who finds the host.
API_DOCS=false
DEPLOYED_COMMIT={{ deployed_commit | trim }}
CLAUDE_API_KEY={{ claude_api_key }}
ELEVENLABS_API_KEY={{ elevenlabs_api_key }}
ELEVENLABS_VOICE_ID={{ elevenlabs_voice_id }}
