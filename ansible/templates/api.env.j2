# Rendered by ansible/deploy.yml; overwritten on every deploy, do not edit here.
# The API, the worker and any CLI run from this directory (`uv run python -m
# app.cli create-user`) all read it.
{# The app's own account once ansible/db_user.yml made it (docs/adr/0012), else cstat's root. #}
{% if app_mysql_secret is defined and app_mysql_secret.content is defined %}
{% set db_user = app_mysql_user %}
{% set db_password = app_mysql_secret.content | b64decode | trim %}
{% else %}
{% set db_user = mysql_user %}
{% set db_password = mysql_password %}
{% endif %}
{% if mysql_host in ['localhost', '127.0.0.1', ''] %}
DATABASE_URL=mysql+pymysql://{{ db_user | urlencode }}:{{ db_password | urlencode }}@localhost/{{ mysql_database }}?unix_socket={{ mysql_socket }}
{% else %}
DATABASE_URL=mysql+pymysql://{{ db_user | urlencode }}:{{ db_password | urlencode }}@{{ mysql_host }}:{{ mysql_port }}/{{ mysql_database }}
{% endif %}
REDIS_BROKER_URL={{ redis_url }}/{{ redis_dbs.broker }}
REDIS_RESULT_URL={{ redis_url }}/{{ redis_dbs.result }}
REDIS_CACHE_URL={{ redis_url }}/{{ redis_dbs.cache }}
JWT_SECRET={{ jwt_secret }}
CORS_ORIGINS=["https://{{ public_domain }}"]
# Swagger off: it maps every endpoint for anyone who finds the host.
API_DOCS=false
DEPLOYED_COMMIT={{ deployed_commit | trim }}
CLAUDE_API_KEY={{ claude_api_key }}
ELEVENLABS_API_KEY={{ elevenlabs_api_key }}
ELEVENLABS_VOICE_ID={{ elevenlabs_voice_id }}
# Alerts (OPS-5): without both, only the log has them.
TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}
TELEGRAM_CHAT_ID={{ telegram_chat_id }}
